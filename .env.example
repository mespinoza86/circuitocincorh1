HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://circuito_app:CAMBIAR@127.0.0.1:55432/circuito_rrhh
PG_BIN=C:/Program Files/PostgreSQL/18/bin
COOKIE_SECURE=false
TRUST_PROXY=false
# Para publicar con HTTPS: COOKIE_SECURE=true, APP_ORIGIN=https://su-dominio
# Gmail/Google Workspace: configure SMTP_HOST=smtp.gmail.com y una credencial autorizada.
# SMTP_PASS es una contraseña de aplicación, si la cuenta lo permite; no la contraseña normal.
# Mantenga SMTP_HOST y SMTP_PASS vacíos hasta configurar el envío en el servidor.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contabilidad@circuitocinco.com
SMTP_PASS=
SMTP_FROM="Contabilidad Circuito Cinco <contabilidad@circuitocinco.com>"
